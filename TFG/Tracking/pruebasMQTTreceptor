import paho.mqtt.client as mqtt
import time
import json

BROKER = "broker.hivemq.com"
PORT = 1883
TOPIC_SUB = "test/chat/pub"  # Escucha al publicador
TOPIC_PUB = "test/chat/sub"  # Envía respuesta

Kp, Ki, Kd = 0, 0, 0
opt_tipo = ""

def convert_data(text: str):
    data = json.loads(text)
    for key, value in data.items():
        globals()[key] = value


def on_message(client, userdata, msg):
    text = msg.payload.decode()
    print(f"📥 Mensaje recibido del publicador: {text}")

    # --- Convert message to variables ---
    convert_data(text)

    # --- Print updated variables ---
    print("Updated values:")  
    print("Kp:", Kp)
    print("Ki:", Ki)
    print("Kd:", Kd)
    print("opt_tipo:", opt_tipo)

    # --- Send reply ---
    reply = "OK"
    client.publish(TOPIC_PUB, reply)


client = mqtt.Client()
client.on_message = on_message

client.connect(BROKER, PORT, 60)
client.subscribe(TOPIC_SUB)

print("Recieved values initially:")
print(Kp, Ki, Kd, opt_tipo)

print("✅ Suscriptor conectado. Esperando mensajes...")
client.loop_forever()
